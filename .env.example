# Twilio
JUDGE_IT_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JUDGE_IT_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JUDGE_IT_TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Outbound call transport
#   pstn (default) — dial the scenario `target` as an E.164 number and let
#                    it route over the PSTN to the bot's DID.
#   sip            — INVITE the LiveKit SIP host directly, no PSTN hop, and
#                    carry correlation headers the bot can read.
# In sip mode the URI is sip:<TRUNK_NUMBER>@<DESTINATION_HOST> and the
# scenario `target` travels in the X-VirtualNumber header — the trunk's
# headersToAttributes maps it to the `virtualNumber` attribute:
#   "headersToAttributes": {"X-VirtualNumber": "virtualNumber"}
# Scenario YAML is unchanged between modes; `target` stays E.164.
# NOTE: job mode REQUIRES sip and returns 400 under pstn — correlation keys on
# the X-JudgeIt-Session-Id SIP header, which a PSTN call cannot carry.
JUDGE_IT_CALL_TRANSPORT=pstn
JUDGE_IT_SIP_DESTINATION_HOST=581mqcm8zvu.sip.livekit.cloud:5060
JUDGE_IT_SIP_TRUNK_NUMBER=1205
JUDGE_IT_SIP_VIRTUAL_NUMBER_HEADER=X-VirtualNumber
# Blank omits ;transport= (Twilio default, UDP). Set tcp if the header
# section grows enough to push the INVITE near the 1500-byte UDP MTU.
JUDGE_IT_SIP_TRANSPORT=
# Only if the LiveKit inbound trunk uses digest auth instead of IP allow-listing.
JUDGE_IT_SIP_AUTH_USERNAME=
JUDGE_IT_SIP_AUTH_PASSWORD=
# Extra static correlation headers, `X-A=1,X-B=2`. X- prefix is required.
JUDGE_IT_SIP_EXTRA_HEADERS=

# Deepgram (STT + TTS)
JUDGE_IT_DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Evaluation LLM. Needed whenever a call is judged — `judge_it run`, `campaign`,
# and job mode with `eval: true` (the default). Job mode with `eval: false`
# skips the judge and does not need this.
JUDGE_IT_GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JUDGE_IT_EVALUATOR_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------- job mode
# Everything below is only needed for job mode (`POST /v1/jobs`), which reads
# faulty production calls from OSV and writes the test scenarios itself.
# See docs/job-api.md for the caller's side, CLAUDE.md for operating it.

# OSV gateway. The REGION IS A PATH SEGMENT — change the URL, nothing else:
#   us  https://llm-studio.judge_it.dev/us/api/interface
#   in  https://llm-studio.judge_it.dev/in/api/interface
#   ca  https://llm-studio.judge_it.dev/ca/api/interface
# Per-job `config.region` overrides this, so one instance can serve all three.
JUDGE_IT_OSV_BASE_URL=https://llm-studio.judge_it.dev/us/api/interface
# A short-lived JudgeItAdmin ACCESS token (~8h), copied from a logged-in
# llm-studio browser session: DevTools > Network > any /api/interface/ request
# > the `authorization: Bearer …` header. Quote it; pydantic strips the quotes.
# Blank fails the job immediately, by design — an empty token would otherwise
# render the header as `Bearer ` and be reported as a network problem.
JUDGE_IT_OSV_ACCESS_TOKEN=""

# Job state and the per-client prompt cache. Any Redis will do:
#   docker run -d -p 6379:6379 redis
JUDGE_IT_REDIS_URL=redis://localhost:6379/0

# The LLM that writes the scenarios. OpenAI's chat-completions schema, so any
# compatible gateway (OpenRouter, Azure) is a base-url swap plus its own key.
JUDGE_IT_LLM_BASE_URL=https://api.openai.com/v1
JUDGE_IT_JOB_GENERATOR_MODEL=gpt-4.1
JUDGE_IT_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server
JUDGE_IT_SERVER_HOST=0.0.0.0
JUDGE_IT_SERVER_PORT=8765
# Must be a PUBLIC https URL — Twilio fetches TwiML and opens the media
# WebSocket against it, so localhost will not work:
#   cloudflared tunnel --url http://localhost:8765
JUDGE_IT_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Storage
JUDGE_IT_DB_PATH=judge_it.db
