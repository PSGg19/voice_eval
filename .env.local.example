# Local development reference. Copy what you need into `.env` and adjust.
# pydantic-settings reads `.env`; a var exported in your shell OUTRANKS the
# file — that shadowing has cost debugging sessions twice, so if a value
# "doesn't apply", check `env | grep VJUDGE` first.

# ── CORE credentials — always required ────────────────────────────────────
VJUDGE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VJUDGE_TWILIO_AUTH_TOKEN=***
VJUDGE_TWILIO_PHONE_NUMBER=+12202206097
VJUDGE_DEEPGRAM_API_KEY=***
VJUDGE_GEMINI_API_KEY=***

# ── STORE — Postgres + Redis are core, not optional ───────────────────────
# Postgres is the machine's NATIVE server (shared with the local OSV stack);
# vjudge owns only the `vjudge` database on it. Redis: `docker compose up -d`.
VJUDGE_DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/vjudge
VJUDGE_REDIS_URL=redis://localhost:6379/0

# ── TRANSPORT — what a "run" physically is ─────────────────────────────────
# text: no phone call. Drives the same bot over OSV's text runtime
#       (channel=VOICE — same flow/modules/tools, no audio). No server, no
#       tunnel, no Twilio. Cheapest and the volume mode.
# sip:  a real voice call as SIP-to-SIP — Twilio INVITEs the region's LiveKit
#       ingress; the bot number rides as the X-VirtualNumber HEADER, never a
#       dialled number, so there is no PSTN leg and it is compliant in every
#       region. Needs the media server + a public tunnel (below). Job mode
#       requires this transport.
# pstn: legacy real dial of the E.164. Refused for region 'in' (S6 —
#       US→India PSTN is a TRAI/DoT violation). US/CA only.
# Precedence: scenario YAML `transport:` > CLI --transport > this default.
VJUDGE_CALL_TRANSPORT=sip

# ── SIP-to-SIP (transport=sip) ─────────────────────────────────────────────
# The deployment-DEFAULT region's LiveKit ingress (US today):
VJUDGE_SIP_DESTINATION_HOST=581mqcm8zvu.sip.livekit.cloud:5060
VJUDGE_SIP_TRUNK_NUMBER=1205
# Region-wise trunks (P3.8) — a run with region 'in' dials THESE instead, so
# US and India runs coexist in one process. India values pending the trunk
# owner (the livekit-vjudgetl-2 project):
# VJUDGE_SIP_DESTINATION_HOST_IN=<vjudgetl-2>.sip.livekit.cloud:5060
# VJUDGE_SIP_TRUNK_NUMBER_IN=<inbound trunk number>
# VJUDGE_SIP_PROVIDER_CONFIG_IN=livekit-vjudgetl-2
# VJUDGE_SIP_DESTINATION_HOST_CA= / VJUDGE_SIP_TRUNK_NUMBER_CA=

# Public URL Twilio uses to reach the media server — refresh per tunnel:
#   cloudflared tunnel --url http://localhost:8765
VJUDGE_PUBLIC_URL=https://<your-tunnel>.trycloudflare.com

# ── TEXT transport (transport=text) ────────────────────────────────────────
VJUDGE_TEXT_RUNTIME_BASE_URL=https://llm-studio.vjudge.dev/us/api/text
# VJUDGE_TEXT_RUNTIME_TOKEN=
# is_test on text: false by default — true hides the run from llm-studio and
# only suppresses the compliance event; post-call CRM writes fire regardless.

# ── OSV (enrichment, correlation, job mode) ────────────────────────────────
# Region is a PATH SEGMENT (us|in|ca). A run's `region` swaps it per run.
VJUDGE_OSV_BASE_URL=https://llm-studio.vjudge.dev/us/api/interface
VJUDGE_OSV_ACCESS_TOKEN="<short-lived VJudgeAdmin JWT — expires ~8h>"
VJUDGE_OPENAI_API_KEY=sk-...        # job-mode scenario generator

# ── V3 API (`vjudge serve` → /v1/runs, /v1/scenarios, …) ───────────────────
# Blank = auth off (acceptable only while localhost-only). Set it the moment
# a tunnel points at this server. Callers send: Authorization: Bearer <token>
VJUDGE_API_TOKEN=

# ── OBSERVABILITY — a choice, off by default, zero cost when off ───────────
# Emitters land with Phase 5 (observers); the containers and these gates are
# ready now. UIs:  Phoenix http://localhost:6006 · Langfuse :3200 (3000 is
# the llm-studio dev server) · Grafana :3001 (anonymous admin) · Loki :3100.
# Start with:
#   docker compose --profile tracing up -d      # Phoenix + Langfuse
#   docker compose --profile logs up -d         # Loki + Grafana
# Tracing: none | phoenix | langfuse | both
TRACING_PROVIDER=none
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
LANGFUSE_HOST=http://localhost:3200
# Pre-provisioned by compose on first boot (LANGFUSE_INIT_*) — no signup:
# UI login dev@local.test / vjudge-local. Local-only credentials, not secrets.
LANGFUSE_PUBLIC_KEY=pk-lf-vjudge-local
LANGFUSE_SECRET_KEY=sk-lf-vjudge-local
# Logs: text | json | loki
LOG_SINK=text
LOKI_URL=http://localhost:3100/loki/api/v1/push
DEPLOY_ENV=local
LOG_LABEL_REGION=us   # low-cardinality labels ONLY — run ids go in the line
# Tail sampling: fraction of PASSED runs to keep as traces (failures are
# ALWAYS kept, regardless). 1.0 = trace everything (local default).
TRACE_SAMPLE_RATE=1.0
# Prometheus counters/gauges + GET /metrics on `vjudge serve`.
METRICS_ENABLED=false
# Write runs/<run_id>/{transcript,run}.json through the artifact store below.
ARTIFACT_OBSERVER=false
# Canary (P5.5): `vjudge canary` runs this scenario once, exit 0/1; schedule
# it with cron and alert on the exit code or the vjudge_canary_* gauges.
# VJUDGE_CANARY_SCENARIO=clients/_examples/happy-path.yaml

# ── ARTIFACTS — local disk now; MinIO/S3 when a UI serves results ──────────
ARTIFACT_STORE=local
ARTIFACT_LOCAL_ROOT=./logs
# ARTIFACT_STORE=s3
# ARTIFACT_S3_BUCKET=vjudge-artifacts
# ARTIFACT_S3_ENDPOINT=http://localhost:9000    # --profile storage (MinIO)
# ARTIFACT_S3_ACCESS_KEY=vjudge
# ARTIFACT_S3_SECRET_KEY=vjudge-local-only
